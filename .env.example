# Mobile client configuration. EXPO_PUBLIC_ values are embedded in the application bundle.
EXPO_PUBLIC_APP_MODE=development
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_LIVE_MODEL=gemini-3.8-live
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=
EXPO_PUBLIC_ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
EXPO_PUBLIC_ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_24000
EXPO_PUBLIC_ELEVENLABS_STT_MODEL_ID=scribe_v2

# Server-side provider experiment. Do not use EXPO_PUBLIC_ values here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_STT_MODEL_ID=scribe_v2
PROVIDER_CHECK_IMAGE_PATH=../../assets/room1.jpg
PROVIDER_CHECK_SECOND_IMAGE_PATH=../../assets/room2.jpg
PROVIDER_CHECK_AUDIO_PATH=../../assets/audio2.ogg
PROVIDER_CHECK_MAX_COST_USD=1
