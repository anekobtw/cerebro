# Mobile client configuration. EXPO_PUBLIC_ values are embedded in the application bundle.
EXPO_PUBLIC_APP_MODE=development
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_SCENE_MODEL=gemini-3.6-flash
EXPO_PUBLIC_GEMINI_LIVE_MODEL=gemini-3.8-live
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=
EXPO_PUBLIC_ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
EXPO_PUBLIC_ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_24000
EXPO_PUBLIC_ELEVENLABS_STT_MODEL_ID=scribe_v2
# Live microphone recognition uses the realtime model, not the batch upload model.
EXPO_PUBLIC_ELEVENLABS_REALTIME_STT_MODEL_ID=scribe_v2_realtime
EXPO_PUBLIC_GOOGLE_ROUTES_ENABLED=false
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_REQUEST_TIMEOUT_MS=5000
# Spoken destinations need the Places API enabled on the same restricted key.
EXPO_PUBLIC_GOOGLE_PLACES_ENABLED=false
EXPO_PUBLIC_GOOGLE_PLACES_SEARCH_RADIUS_M=3000
EXPO_PUBLIC_GOOGLE_PLACES_REGION=us
# GPS guidance stops at this distance and hands the last stretch to the camera.
EXPO_PUBLIC_NAV_ARRIVAL_RADIUS_M=30
EXPO_PUBLIC_NAV_MAX_REROUTES_PER_SESSION=3
EXPO_PUBLIC_NAV_REROUTE_COOLDOWN_MS=30000
