{
  "cli": {
    "version": ">=24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "production",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "development"
      }
    },
    "preview": {
      "channel": "production",
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "preview"
      }
    }
  }
}
