{
  "expo": {
    "name": "Cerebro",
    "slug": "cerebro",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.cerebro.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cerebro to use the camera for navigation assistance.",
          "microphonePermission": "Allow Cerebro to use the microphone for voice assistance.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Cerebro to use your location while navigating."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Allow Cerebro to use the microphone for voice assistance.",
          "androidPermissions": [
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
          ],
          "androidFSTypes": [
            "mediaPlayback"
          ]
        }
      ]
    ]
  }
}
